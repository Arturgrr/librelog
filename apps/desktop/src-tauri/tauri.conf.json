{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Librelog Dev",
  "version": "../package.json",
  "mainBinaryName": "librelog-dev",
  "identifier": "com.arturgrr.librelog.dev",
  "build": {
    "features": ["direct-distribution"],
    "beforeDevCommand": "pnpm -F desktop dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "pnpm -F desktop build",
    "beforeBundleCommand": "node ./src-tauri/scripts/before-bundle.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": false,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*",
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "publisher": "Artur Guerra",
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Local-first AI meeting notepad",
    "longDescription": "Librelog records and transcribes meetings on your computer and turns them into notes. No account, no billing, no telemetry: your audio, your notes, your keys.",
    "homepage": "https://github.com/Arturgrr/librelog",
    "license": "MIT",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/librelog.desktop",
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "libpipewire-0.3-0",
          "libpulse0",
          "libasound2",
          "libssl3",
          "libdbus-1-3",
          "libvulkan1",
          "libstdc++6",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-tools",
          "gstreamer1.0-pipewire",
          "at-spi2-core",
          "ca-certificates",
          "desktop-file-utils",
          "xdg-utils"
        ],
        "recommends": ["gstreamer1.0-libav", "wl-clipboard", "libglib2.0-bin"]
      },
      "rpm": {
        "desktopTemplate": "linux/librelog.desktop",
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator-gtk3",
          "pipewire-libs",
          "pulseaudio-libs",
          "alsa-lib",
          "openssl-libs",
          "dbus-libs",
          "vulkan-loader",
          "libstdc++",
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good",
          "gstreamer1-plugins-bad-free",
          "gstreamer1",
          "pipewire-gstreamer",
          "at-spi2-core",
          "ca-certificates",
          "desktop-file-utils",
          "xdg-utils"
        ],
        "recommends": ["gstreamer1-plugin-openh264", "wl-clipboard", "glib2"]
      }
    },
    "externalBin": [],
    "icon": [
      "icons/dev/32x32.png",
      "icons/dev/128x128.png",
      "icons/dev/128x128@2x.png",
      "icons/dev/icon.icns",
      "icons/dev/icon.ico"
    ],
    "resources": {
      "resources/graphite/AppIcon.icns": "icons/graphite.icns",
      "resources/light/AppIcon.icns": "icons/light.icns",
      "resources/notification-icons": "notification-icons",
      "../../../LICENSE": "licenses/LICENSE",
      "../../../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../../../licenses/Apache-2.0.txt": "licenses/Apache-2.0.txt",
      "../../../licenses/BSD-2-Clause-AudioCap.txt": "licenses/BSD-2-Clause-AudioCap.txt",
      "../../../licenses/MIT.txt": "licenses/MIT.txt",
      "../../../crates/mp3/LICENSE-LAME.txt": "licenses/LICENSE-LAME.txt",
      "../../../crates/export-core/fonts/OFL.txt": "licenses/Pretendard-OFL.txt",
      "../../../licenses/OFL-1.1-Inter.txt": "licenses/OFL-1.1-Inter.txt",
      "../../../licenses/OFL-1.1-IBM-Plex-Mono.txt": "licenses/OFL-1.1-IBM-Plex-Mono.txt",
      "../../../licenses/llama.cpp/LICENSE": "licenses/llama.cpp/LICENSE",
      "../../../licenses/llama.cpp/cpp-httplib-LICENSE": "licenses/llama.cpp/cpp-httplib-LICENSE",
      "../../../licenses/llama.cpp/nlohmann-json-LICENSE": "licenses/llama.cpp/nlohmann-json-LICENSE",
      "../../../licenses/llama.cpp/xxhash-LICENSE": "licenses/llama.cpp/xxhash-LICENSE",
      "../../../licenses/llama.cpp/rotate-bits-LICENSE": "licenses/llama.cpp/rotate-bits-LICENSE",
      "../../../licenses/llama.cpp/sha1-LICENSE": "licenses/llama.cpp/sha1-LICENSE",
      "../../../licenses/llama.cpp/sha256-LICENSE": "licenses/llama.cpp/sha256-LICENSE",
      "../../../licenses/llama.cpp/stb_image-LICENSE": "licenses/llama.cpp/stb_image-LICENSE",
      "../../../licenses/llama.cpp/miniaudio-LICENSE": "licenses/llama.cpp/miniaudio-LICENSE"
    },
    "macOS": {
      "minimumSystemVersion": "15.0",
      "entitlements": "./Entitlements.plist",
      "dmg": {
        "background": "assets/dmg-background-stable.png",
        "windowSize": {
          "width": 660,
          "height": 430
        },
        "appPosition": {
          "x": 177,
          "y": 200
        },
        "applicationFolderPosition": {
          "x": 483,
          "y": 200
        }
      },
      "files": {
        "Resources/mlx-swift_Cmlx.bundle/default.metallib": "resources/mlx.metallib",
        "Resources/AppIcon.icns": "resources/graphite/AppIcon.icns"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["librelog-dev"]
      }
    },
    "updater": {
      "active": false,
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2QkYwMzg1OTQ2NDgzNDkKUldSSmcyU1VoUU8vZGxFRkRCQkc5T2dMTmhFK2dVR3pQSHo0WnoydVcyek9YajEzM2pEemp1WWwK"
    }
  }
}
